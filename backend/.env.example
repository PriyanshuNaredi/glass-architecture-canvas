# Glass backend — LLM provider configuration
# Copy this file to .env and fill in the key for your chosen provider.
# No key? The pipeline falls back to deterministic templates automatically.

# gemini (default, free tier) | openai | anthropic
GLASS_LLM_PROVIDER=gemini

# Gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides
GLASS_GEMINI_MODEL=gemini-2.0-flash
GLASS_OPENAI_MODEL=gpt-4o-mini
GLASS_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=
